# ==========================================
# EduCareer AI — Root Environment Example
# Copy to backend/.env and frontend/.env.local
# ==========================================

# --- BACKEND (backend/.env) ---

# Application
APP_NAME=EduCareer AI
DEBUG=True
ENVIRONMENT=development

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-at-least-32-chars-long

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/educareer

# Groq API — get free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ChromaDB (vector store — no external service needed)
CHROMA_PERSIST_DIR=./chroma_db

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]


# --- FRONTEND (frontend/.env.local) ---

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
